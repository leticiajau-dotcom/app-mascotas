# Copia este archivo a .env (o .env.local) y completá con tus credenciales de
# Supabase (Project Settings → API en el dashboard de supabase.com).
# Con Vite, las variables que va a usar el navegador deben empezar con VITE_.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
